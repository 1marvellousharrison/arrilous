{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo Serving the committed Flutter web build from app/build/web",
  "outputDirectory": "app/build/web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-YOUR-RENDER-SERVICE.onrender.com/api/:path*"
    }
  ]
}
