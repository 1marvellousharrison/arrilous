{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "app/build/web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://arrilous.onrender.com/api/$1"
    },
    {
      "src": "/",
      "dest": "/app/build/web/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/app/build/web/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/app/build/web/$1"
    }
  ]
}
