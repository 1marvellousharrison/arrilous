# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# ── Database ───────────────────────────────────────────────
# SQLite file. Use ":memory:" for throwaway test runs.
DATABASE_PATH=./data/app.db

# ── Auth secrets ───────────────────────────────────────────
# REQUIRED in production — the server refuses to boot without it.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ISSUER=dee-api
JWT_AUDIENCE=dee-app
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ── OTP ────────────────────────────────────────────────────
OTP_TTL=600
# Dev only: echoes the code in the API response (no SMS/email provider yet).
# Automatically disabled when NODE_ENV=production.
OTP_EXPOSE_IN_RESPONSE=true

# ── Rate limiting (per process, in-memory) ─────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=*
